{
  "name": "filesplitter",
  "version": "1.1.0",
  "description": "100% client-side, mobile-first file splitter & merger. No upload, no server - files never leave the device.",
  "private": true,
  "type": "module",
  "homepage": "https://nitesh99390.github.io/Filesplitter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nitesh99390/Filesplitter.git"
  },
  "bugs": {
    "url": "https://github.com/Nitesh99390/Filesplitter/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs 8080 src",
    "serve": "node scripts/serve.mjs 8080 .",
    "pretest": "npm run build",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "check": "node --check app.js && node --check src/app.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "javascript-obfuscator": "^4.2.2",
    "terser": "^5.51.2"
  }
}
